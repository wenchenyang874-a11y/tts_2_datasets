# Keep loopback-only until an access token is set. Change to 0.0.0.0 for LAN use.
TTS_APP_BIND_ADDRESS=127.0.0.1
TTS_APP_PORT=8080
TTS_APP_HOST_DATA_DIR=./var
# Match these to `id -u` and `id -g` on the Docker host.
TTS_APP_UID=1000
TTS_APP_GID=1000

# Optional build mirrors for networks where Docker Hub or deb.debian.org is slow.
TTS_PYTHON_IMAGE=python:3.11-slim-bookworm
TTS_DEBIAN_MIRROR=
TTS_PIP_INDEX_URL=

# Direct Python execution stores data here. Compose overrides it with /data.
TTS_APP_DATA_DIR=./var
# Optional logical data root for manifest-only exports. Compose uses /data;
# direct Python execution defaults to the resolved TTS_APP_DATA_DIR.
TTS_APP_LOG_LEVEL=info
TTS_APP_WORKERS=2
TTS_MAX_UPLOAD_MB=512
TTS_MAX_TASK_ITEMS=5000

# Lightweight API protection. It may be empty only while bound to 127.0.0.1;
# set a strong value before changing TTS_APP_BIND_ADDRESS to 0.0.0.0.
# Generate a value with: openssl rand -hex 32
TTS_APP_API_TOKEN=

# Provider request behavior.
TTS_HTTP_TIMEOUT_SECONDS=60
TTS_RETRY_COUNT=3
TTS_MAX_PROVIDER_AUDIO_MB=32
# Keep disabled. Enable only for a deliberate local HTTP mock endpoint.
TTS_ALLOW_INSECURE_PROVIDER_HTTP=0

# Cloud provider credentials are configured in the Web UI and stored under
# TTS_APP_DATA_DIR. Do not put Alibaba Cloud or Volcengine keys in this file.
